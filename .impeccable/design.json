    {
      "name": "Method disclosure",
      "kind": "custom",
      "refersTo": "disclosure",
      "description": "Native disclosure for arithmetic and provenance limitations.",
      "html": "<details class=\"ds-method\"><summary>How this adjustment works</summary><p>Each exact wording group contributes its mean stars as one vote. No entry is labeled fake.</p></details>",
